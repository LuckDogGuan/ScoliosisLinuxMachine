#!/bin/sh

case "$1" in
    start)
        app=/opt/instrument/bin/instrument_app
        config=/opt/instrument/config.json
        [ -x "$app" ] && [ -f "$config" ] || exit 0
        if ! pidof instrument_app >/dev/null 2>&1; then
            logs=/opt/instrument/logs
            umask 077
            mkdir -p "$logs"
            # Drain every line, rotating only these diagnostic files.
            "$app" "$config" </dev/null 2>&1 | (
                umask 077
                while IFS= read -r line; do
                    printf '%.1900s\n' "$line" >> "$logs/startup.log"
                    size=$(wc -c < "$logs/startup.log")
                    if [ "$size" -ge 1048576 ]; then
                        mv -f "$logs/startup.log.1" "$logs/startup.log.2" 2>/dev/null || :
                        mv -f "$logs/startup.log" "$logs/startup.log.1"
                    fi
                done
            ) &
        fi
        ;;
esac
